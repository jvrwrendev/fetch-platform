# Copy to .env.local and fill in. `.env.local` is gitignored.
#
# The deploy key pushes schema and functions to the dev deployment. Treat it
# as a secret: never commit it, and rotate it if it has been shared.
CONVEX_DEPLOY_KEY=dev:your-deployment-name|your-deploy-key

# The public client URL the app talks to. Safe to share.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
