# FETCH backend — environment template.
# Copy to .env and fill in. NONE of these are needed for the mock build;
# they describe what a real service would read.

# --- HTTP ---
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Database ---
# e.g. postgres://user:password@localhost:5432/fetch
DATABASE_URL=
JWT_SECRET=

# --- Maps & routing (server-side keys) ---
# OpenRouteService for road distance / directions.
ORS_KEY=
# MapTiler for forward/reverse geocoding.
MAPTILER_KEY=

# --- Payments ---
# Only needed once online payment is offered; the mock uses cash/gcash/maya.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
