# Frontend environment template.
# Copy to `.env` if you need to override defaults. NONE of these are required
# for the mock build — the app reads from `src/data/mock` and `@fetch/shared`.
#
# Expo exposes only variables prefixed with EXPO_PUBLIC_ to the app bundle.

# Base URL of a real FETCH API. Unset in the mock build.
EXPO_PUBLIC_API_URL=

# Server-side map/routing keys, if the mock provider is swapped out.
EXPO_PUBLIC_MAPS_KEY=
